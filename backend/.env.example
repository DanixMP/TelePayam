ENVIRONMENT=development
DEBUG=true
# Local development default. Docker Compose sets PostgreSQL for its own services.
DATABASE_URL=sqlite+aiosqlite:///./messenger.db
# DATABASE_URL=postgresql+asyncpg://messenger:messenger@localhost:5432/messenger
# Leave empty for the in-process store. Required in production.
REDIS_URL=
JWT_SECRET=development-only-jwt-secret-change-me
# Leave empty in development to derive a key from JWT_SECRET.
# Production requires a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
DATA_HMAC_KEY=development-only-hmac-key-change-me
SMS_PROVIDER=console
MEDIA_ROOT=./var/media
PUBLIC_BASE_URL=http://localhost:8000
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
CORS_ORIGINS=["http://localhost:3000"]
